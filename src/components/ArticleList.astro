---
import { artikelUrl, datumTekst, leestijdTekst, type Artikel } from '../lib/artikelen';

interface Props {
  artikelen: Artikel[];
  metLeestijd?: boolean;
}
const { artikelen, metLeestijd = false } = Astro.props;
---

<ul class="artikellijst">
  {artikelen.map((artikel) => (
    <li class="artikellijst__item" data-onderwerpen={artikel.data.topics.join('|')}>
      <a href={artikelUrl(artikel)} class="artikellijst__link">
        <span class="artikellijst__titel">{artikel.data.title}</span>
        <span class="artikellijst__meta">
          {artikel.data.topics.join(', ')} · <time datetime={artikel.data.date.toISOString()}>{datumTekst(artikel.data.date)}</time>
          {metLeestijd && <> · {leestijdTekst(artikel)}</>}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .artikellijst {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .artikellijst__item {
    border-bottom: 1px solid var(--color-line);
  }

  .artikellijst__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .artikellijst__link:hover {
    color: var(--color-ink);
  }

  .artikellijst__link:hover .artikellijst__titel {
    color: var(--color-cobalt-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .artikellijst__titel {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
  }

  .artikellijst__meta {
    font-size: var(--text-meta);
    font-weight: 400;
    color: var(--color-muted);
  }
</style>
