---
import Avatar from './Avatar.astro';
import { homeInstellingen, siteInstellingen } from '../lib/instellingen';
const site = await siteInstellingen();
const home = await homeInstellingen();
---

<section class="over-mij-blok" aria-labelledby="over-mij-blok-titel">
  <Avatar foto={site.foto} naam={site.naam} grootte={104} />
  <div class="over-mij-blok__tekst">
    <h2 id="over-mij-blok-titel">{home.overMijTitel ?? 'Over mij'}</h2>
    {home.overMijTekst && <p>{home.overMijTekst}</p>}
    <a class="text-link" href="/over-mij/">Lees meer over mij</a>
  </div>
</section>

<style>
  .over-mij-blok {
    background: var(--color-cobalt-soft);
    border-radius: var(--radius-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .over-mij-blok {
      flex-direction: row;
      align-items: center;
      gap: 32px;
      padding: 48px;
    }
  }

  h2 {
    color: var(--color-cobalt-ink);
    font-size: clamp(24px, 1vw + 1rem, 28px);
  }

  p {
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.6;
    max-width: 560px;
  }

  .text-link {
    margin-top: 8px;
    color: var(--color-cobalt-ink);
  }
</style>
