---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { alleArtikelen } from '../lib/artikelen';

const nieuwste = (await alleArtikelen()).slice(0, 3);
---

<BaseLayout title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer)." noindex>
  <div class="container pagina">
    <header class="pagina__kop">
      <p class="meta-label">Fout 404</p>
      <h1>Deze pagina bestaat niet</h1>
      <p class="intro">Misschien is het adres veranderd of zit er een typfout in. Geen zorgen, hier kom je weer verder.</p>
      <p class="acties">
        <a class="button" href="/">Naar de homepage</a>
        <a class="text-link" href="/artikelen/">Alle artikelen</a>
      </p>
    </header>
    {nieuwste.length > 0 && (
      <section aria-labelledby="nieuwste-404">
        <h2 id="nieuwste-404" class="meta-label">Nieuwste artikelen</h2>
        <ArticleList artikelen={nieuwste} />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  h1 {
    margin-top: 12px;
  }

  .acties {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  section {
    margin-top: 48px;
  }

  section h2 {
    margin-bottom: 8px;
  }
</style>
